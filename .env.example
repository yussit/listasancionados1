NODE_ENV=development
PORT=3000

# Usuarios en data/users.json. Use: npm run hash-password -- "su-clave-segura"
SESSION_SECRET=cambie-este-secreto-largo-en-produccion
SESSION_TTL_MINUTES=480

# Fuente de datos. Prioridad:
# 1) Google Sheets privado con cuenta de servicio
# 2) CSV publicado por URL
# 3) data/sanciones.csv local
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_RANGE=Sanciones!A:H
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
DATA_CSV_URL=
DATA_CACHE_TTL_MS=300000
DATA_SYNC_INTERVAL_MS=300000

# Control de búsqueda
MIN_SEARCH_LENGTH=3
